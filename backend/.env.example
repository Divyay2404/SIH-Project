# =============================================================================
# Backend Environment Configuration Template
# Copy to .env for local overrides or set in your cloud provider settings
# =============================================================================

# Server Port (automatically provided by hosting platforms like Render/Railway)
PORT=8000

# Environment mode: development | production
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated URLs, or * for open access)
CORS_ORIGINS=https://sih-project.vercel.app,http://localhost:5173

# Regular Expression for dynamic Vercel preview and production deployments
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Optional explicit Tesseract OCR data directory path (if non-standard)
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
